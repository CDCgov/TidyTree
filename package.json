{
  "version": "0.8.0",
  "description": "Uncompromisingly Flexible Phylogenetic Trees, Powered by D3.js",
  "name": "tidytree",
  "type": "module",
  "main": "dist/tidytree.js",
  "scripts": {
    "all": "npm run build && npm run minify && npm run doc",
    "build": "rollup -c",
    "demo": "http-server",
    "dev": "npm run demo & npm run watch",
    "doc": "documentation build src/main.ts -f md -o docs/README.md",
    "lint": "eslint src/",
    "minify": "npx terser dist/tidytree.js --compress > dist/tidytree.min.js",
    "test": "vitest run",
    "version": "npm version patch",
    "watch": "rollup -c --watch"
  },
  "author": "Tony Boyles <aaboyles@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdcgov/TidyTree.git"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "patristic": "^0.7.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/d3": "^7.4.3",
    "documentation": "^14.0.3",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "rollup": "^4.64.5",
    "tslib": "^2.8.1",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5"
  }
}
