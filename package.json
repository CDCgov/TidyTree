{
  "version": "0.8.1",
  "description": "Uncompromisingly Flexible Phylogenetic Trees, Powered by D3.js",
  "name": "tidytree",
  "type": "module",
  "main": "dist/tidytree.js",
  "scripts": {
    "all": "npm run build && npm run doc",
    "build": "rollup -c",
    "demo": "http-server",
    "dev": "npm run demo & npm run watch",
    "doc": "documentation build src/main.ts -f md -o docs/README.md",
    "lint": "eslint src/",
    "release": "commit-and-tag-version",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "watch": "rollup -c --watch"
  },
  "author": "Tony Boyles <aaboyles@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdcgov/TidyTree.git"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "patristic": "^0.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/d3": "^7.4.3",
    "commit-and-tag-version": "^13.3.0",
    "documentation": "^14.0.3",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "http-server": "^14.1.1",
    "rollup": "^4.64.5",
    "tslib": "^2.8.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
